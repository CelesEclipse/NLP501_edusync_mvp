# large media and raw recordings: never in git (see README)
lessons/*/video.*
lessons/*/audio.*
lessons/*/audio/
lessons/*/chat.txt
private/
# demo/ is filled from a lesson by demo/prepare.py
demo/lecture.*
demo/slides/
demo/alignment.json
demo/slides.json
demo/transcript.json
demo/links.json
# downloaded PDFs (python fetch_materials.py --pdf ...)
materials/*.pdf
.venv/
__pycache__/
.DS_Store
# screen images extracted from videos, and raw YouTube metadata
lessons/*/screens/
lessons/*/.source.json
# content extracted from third-party lesson videos (the repo is public): keep local until the team decides
lessons/ece-*/screens.json
lessons/ece-*/transcript.json
lessons/ece-*/content.*
